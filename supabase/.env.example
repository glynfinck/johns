# Copy to .env.local beside this file: `supabase start` reads it for the
# env(...) values in config.toml. Any value works locally; the e2e and db
# suites mint sessions without Google. `npm run provision` writes the real
# clients here once Google's are set up: the web's, then the app's iOS and
# Android ones, comma-separated, so a development build can sign in too.
AUTH_GOOGLE_CLIENT_ID=local
AUTH_GOOGLE_SECRET=local
