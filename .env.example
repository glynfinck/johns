# Copy to .env.local. `supabase status -o env` prints the local values.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. The engine (lib/engine) and the db/e2e test tiers use it.
SUPABASE_SERVICE_ROLE_KEY=

# --- The app -------------------------------------------------------------------
# Absolute origin for join links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3205
# Shared secret for /api/cron/tick. Production: the same value goes in the
# Supabase Vault secret `johhs_tick_secret` (see DEPLOYMENT.md).
CRON_SECRET=local-tick-secret

# --- Push reminders (optional) ---------------------------------------------------
# `npm run vapid` prints a pair. Without them the app simply offers no reminders.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Google sign-in for `supabase start` -------------------------------------------
# Read by supabase/config.toml. Any value works locally; the e2e and db suites
# mint sessions without Google.
AUTH_GOOGLE_CLIENT_ID=local
AUTH_GOOGLE_SECRET=local
