{
  "expo": {
    "name": "Jonz",
    "slug": "jonz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jonz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.glyn.jonz",
      "usesAppleSignIn": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f3aa00",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.glyn.jonz"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false,
          "redirects": [
            { "source": "/wall", "destination": "/house/wall" },
            { "source": "/stake", "destination": "/house/stake" },
            { "source": "/table", "destination": "/house" }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e7e9e5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#111315"
          }
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Jonz uses the camera for photo receipts, so the house can see a John is done.",
          "photosPermission": "Jonz uses your photos for photo receipts, so the house can see a John is done.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
