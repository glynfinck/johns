# Copy to .env.local beside this file. EXPO_PUBLIC_ values are bundled into
# the app and visible to anyone: only the public URL and key belong here.
# `supabase status -o env` prints the local ones.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# apps/api, for the few moves that need a server.
EXPO_PUBLIC_API_URL=http://localhost:3205
# Google sign-in on iOS and Android (public client IDs from Google Cloud;
# DEPLOYMENT.md says how to make them). The web build doesn't need them.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
