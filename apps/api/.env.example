# Copy to .env.local beside this file. `supabase status -o env` prints the
# local values. The Google client for `supabase start` is in supabase/.env.example.

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54341
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. The engine (lib/engine) and the db/e2e test tiers use it.
SUPABASE_SERVICE_ROLE_KEY=

# --- The API for the Expo app ------------------------------------------------------
# Web origins allowed to call /api/* from elsewhere, comma-separated: the Expo
# app's web build. Phones send no Origin; production needs none yet.
ALLOWED_ORIGINS=http://localhost:8205

# --- The app -------------------------------------------------------------------
# Absolute origin for join links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3205
# Shared secret for /api/cron/tick. Production: the same value goes in the
# Supabase Vault secret `johns_tick_secret` (see DEPLOYMENT.md).
CRON_SECRET=local-tick-secret

# --- Push reminders (optional) ---------------------------------------------------
# `npm run vapid` prints a pair. Without them the app simply offers no reminders.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Describe your house (optional) -------------------------------------------
# Claude drafts a new house's John list (POST /api/setup/draft) through
# Vercel's AI Gateway. On Vercel it signs in with the project's OIDC token, so
# this is only for trying a real draft locally (a key from the Vercel
# dashboard's AI Gateway page). Without it, setup offers the starter lists.
AI_GATEWAY_API_KEY=

# --- Email (optional) ----------------------------------------------------------
# Resend sends Jonz's emails (lib/email.ts): a key with "Sending access" only.
# Without it nothing is sent and each email is logged as skipped.
# `npm run email:preview` draws every email without sending anything.
RESEND_API_KEY=
# EMAIL_FROM=Jonz <hello@jonz.app>

# --- The House Pass on the web (optional) ------------------------------------
# Stripe Checkout and its webhook (POST /api/stripe/webhook). Use the Jonz
# sandbox's test key locally; `stripe listen --forward-to
# localhost:3205/api/stripe/webhook` prints a webhook secret. Without a key
# the Pass page shows the plans and sells nothing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends a buyer back: the Expo web build (or the page that asked,
# when it's one of ALLOWED_ORIGINS).
APP_URL=http://localhost:8205
